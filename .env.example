NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
SESSION_SECRET=replace-with-32-or-more-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/api/slack/callback
API_PUBLIC_URL=http://localhost:4000
ENCRYPTION_KEY=
# Configure all SMTP_* values to deliver through a real provider. Leave all blank to use Ethereal previews.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WORKER_CONCURRENCY=10
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_EMAILS_PER_HOUR_GLOBAL=
MAX_ATTEMPTS=5
STUCK_TIMEOUT_MS=300000
MAX_CONSECUTIVE_FAILURES=5
CIRCUIT_OPEN_DURATION_MS=900000
OUTBOX_RELAY_INTERVAL_MS=1000
STUCK_SWEEP_INTERVAL_MS=60000
RATE_LIMIT_TTL_MS=7200000
MAX_RATE_WINDOW_PROBES=48
API_RATE_LIMIT_PER_MINUTE=120
